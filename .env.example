# Copy to .env and fill in. Never commit .env.
# The LLM is optional. Without a key (or with LLM_ENABLED=false) the persona endpoint returns the rule-based persona.
# false = never call the LLM (no key / no credits / offline demo).
LLM_ENABLED=false
# openai (default) or anthropic. The key for the selected provider is the one used.
LLM_PROVIDER=openai
# Empty = provider default: gpt-4.1-mini (openai) or claude-haiku-5-5 (anthropic).
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Only if the Anthropic key is not scoped to a workspace (Console > Settings > Workspaces shows the ID, wrkspc_...).
ANTHROPIC_WORKSPACE_ID=
DATABASE_URL=sqlite:///./persona.db
SUPPLIER_DATA_DIR=./data
CONVERSATION_DATA_DIR=./data/conversations

# Without ADMIN_TOKEN, admin routes accept direct local requests only.
ADMIN_TOKEN=
# REQUIRED before exposing the API through a tunnel: Sarvam's tools send it as a Bearer token.
# Use a random value made only for this API (never a Sarvam or Anthropic key), e.g.:
#   python -c "import secrets; print('vani_' + secrets.token_urlsafe(32))"
API_TOKEN=
